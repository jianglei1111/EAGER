{
  "schema_version": 2,
  "purpose": "Public EAGER release boundary and reproducibility inventory",
  "include": [
    ".gitattributes",
    ".gitignore",
    "README.md",
    "EXPORT_MANIFEST.json",
    "pyproject.toml",
    "analysis",
    "configs",
    "experiments_sandbox",
    "prompts",
    "provenance",
    "requirements",
    "results",
    "scripts",
    "splits",
    "src",
    "tests",
    "wsdm"
  ],
  "exclude_globs": [
    "**/.git/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.pyo",
    "**/.pytest_cache/**",
    "**/.mypy_cache/**",
    "**/.ruff_cache/**",
    "**/*.log",
    "**/*.tmp",
    "**/*.zip",
    "**/llm_config.local.json",
    "**/data/**",
    "**/artifacts/**",
    "**/tmp/**"
  ]
}
